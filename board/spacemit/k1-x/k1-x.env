baudrate=115200
earlycon=sbi
stderr=serial
stdin=serial
stdout=serial

bootcmd=mmc dev 2; \
ext4load mmc 2:5 ${kernel_addr_r} Image; \
ext4load mmc 2:5 ${dtb_addr} k1-x_MUSE-Pi-Pro.dtb; \
booti ${kernel_addr_r} - ${dtb_addr}

bootargs=console=ttyS0,115200 earlycon=sbi root=/dev/mmcblk2p6 rootfstype=ext4 rootwait init=/sbin/init devtmpfs.mount=1
