baudrate=115200
earlycon=sbi
stderr=serial
stdin=serial
stdout=serial

baudrate=115200
earlycon=sbi
stderr=serial
stdin=serial
stdout=serial

bootargs_nvme=console=ttyS0,115200 earlycon=sbi root=/dev/nvme0n1p1 rootfstype=ext4 rootwait init=/sbin/init devtmpfs.mount=1
bootargs_mmc=console=ttyS0,115200 earlycon=sbi root=/dev/mmcblk2p1  rootfstype=ext4 rootwait init=/sbin/init devtmpfs.mount=1

boot_nvme=nvme scan; \
  if ext4load nvme 0:1 ${kernel_addr_r} /boot/Image; then \
    if ext4load nvme 0:1 ${dtb_addr} /boot/k1-x.dtb; then \
      echo Booting from NVMe...; \
      setenv bootargs ${bootargs_nvme}; \
      booti ${kernel_addr_r} - ${dtb_addr}; \
    else \
      echo NVMe DTB missing; false; \
    fi; \
  else \
    echo NVMe Image missing; false; \
  fi

boot_emmc=mmc dev 2; \
  if ext4load mmc 2:1 ${kernel_addr_r} /boot/Image; then \
    if ext4load mmc 2:1 ${dtb_addr} /boot/k1-x.dtb; then \
      echo Booting from eMMC (mmc2:1)...; \
      setenv bootargs ${bootargs_mmc}; \
      booti ${kernel_addr_r} - ${dtb_addr}; \
    else \
      echo eMMC DTB missing; false; \
    fi; \
  else \
    echo eMMC Image missing; false; \
  fi

bootcmd=run boot_nvme